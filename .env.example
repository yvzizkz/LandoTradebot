# OpenAI API Key (required for AI analysis features)
OPENAI_API_KEY=your_openai_api_key_here

# Database
DATABASE_URL="file:./prisma/dev.db"

# Provider selection (all default to "simulator")
MARKET_CRYPTO_PROVIDER=simulator
MARKET_FOREX_PROVIDER=simulator
MARKET_KALSHI_PROVIDER=simulator

# Binance (required if MARKET_CRYPTO_PROVIDER=binance)
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_SANDBOX=true

# Coinbase (required if MARKET_CRYPTO_PROVIDER=coinbase)
COINBASE_API_KEY=
COINBASE_SECRET=
COINBASE_SANDBOX=true

# OANDA (required if MARKET_FOREX_PROVIDER=oanda)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_PRACTICE=true

# Kalshi (required if MARKET_KALSHI_PROVIDER=kalshi)
KALSHI_EMAIL=
KALSHI_PASSWORD=
KALSHI_DEMO=true
